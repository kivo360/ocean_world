{
  "name": "ocean-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run ontology:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ontology:codegen": "node --env-file-if-exists=.env.local --import tsx scripts/codegen.ts",
    "ontology:validate": "node --env-file-if-exists=.env.local --import tsx scripts/ontology-validate.ts",
    "ontology:build": "node --env-file-if-exists=.env.local --import tsx scripts/orchestrator-run.ts",
    "agent:serve": "node --env-file-if-exists=.env.local --import tsx scripts/agent-bridge-serve.ts",
    "sandbox:serve": "node --env-file-if-exists=.env.local --import tsx scripts/sandbox-agent-serve.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@surrealdb/wasm": "^2.6.1",
    "oxigraph": "^0.5.7",
    "pixi.js": "^8.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sandbox-agent": "^0.4.2",
    "surrealdb": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
