# Ocean World environment variables. Copy to .env.local and fill in the values
# you want. Everything is optional — without any of these the project runs
# fully offline with deterministic stand-ins.

# --- LLM providers (direct calls: proposer, T3) -----------------------------
# Fireworks is the preferred provider. Set this to get live LLM calls.
FIREWORKS_API_KEY=
# Optional overrides. Defaults:
#   chat:       accounts/fireworks/routers/kimi-k2p5-turbo
#   embeddings: accounts/fireworks/models/qwen3-embedding-8b  (Matryoshka, 768-dim slice)
FIREWORKS_CHAT_MODEL=
FIREWORKS_EMBEDDING_MODEL=
FIREWORKS_EMBEDDING_DIMENSIONS=768

# --- Browser-side LLM (Vite-exposed; only the VITE_ prefix reaches the SPA) -
# Mirror the Fireworks key here to drive in-browser T3 deliberation. WARNING:
# anything VITE_-prefixed is bundled into the public assets — only use this
# in local dev. For production, proxy LLM calls through a server.
VITE_FIREWORKS_API_KEY=
VITE_FIREWORKS_CHAT_MODEL=
VITE_FIREWORKS_BASE_URL=

# Anthropic is the fallback for direct calls (and the only option when no
# Sandbox Agent server is running).
ANTHROPIC_API_KEY=

# --- Embeddings -------------------------------------------------------------
# Fireworks handles embeddings too when FIREWORKS_API_KEY is set. If you'd
# rather use OpenAI's endpoint for embeddings only:
OPENAI_API_KEY=

# --- Sandbox Agent (SDK-agent hosting: critic, observer, coding agent) ------
# When this is set, the critic and observer route through a Sandbox Agent
# session instead of a direct LLM call. Run `npm run sandbox:serve` to boot a
# local instance.
SANDBOX_AGENT_URL=http://127.0.0.1:2468
SANDBOX_AGENT_NAME=claude

# --- Storage ----------------------------------------------------------------
# Point to a running SurrealDB for persistence. Omit to stay in-memory.
SURREAL_URL=
SURREAL_NS=ocean
SURREAL_DB=world
SURREAL_USER=root
SURREAL_PASS=root

# --- Simulation defaults ----------------------------------------------------
INITIAL_PERSONS=70
INITIAL_MERCHANTS=8
INITIAL_WANDERERS=22
